# Telegram bot token from BotFather. Never commit the real value.
BOT_TOKEN=replace-with-telegram-bot-token

# Shared by account and battle. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_AUTH_SECRET=replace-with-at-least-32-random-characters

APP_ENV=development

# Local-only database/Redis values. Use a secret manager for production.
POSTGRES_USER=local_user
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_DB=bot
NEWS_DB_NAME=news
REDIS_PASSWORD=replace-with-local-redis-password
