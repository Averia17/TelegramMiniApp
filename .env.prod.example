# Copy to .env.prod. This is a complete, independent production environment.
# Keep this file local; it is intentionally ignored by git.

# Production bot and application data stores. Do not rely on .env here.
BOT_TOKEN=replace-with-production-bot-token
ADMINS=
USE_REDIS=true
POSTGRES_USER=replace-with-production-postgres-user
POSTGRES_PASSWORD=replace-with-production-postgres-password
POSTGRES_DB=bot
DB_HOST=db
SHOP_DB_HOST=shop-db
REDIS_HOST=redis
REDIS_PORT=6388
REDIS_DB=0
REDIS_PASSWORD=replace-with-production-redis-password

# Must be at least 32 characters and shared by account, battle and party.
APP_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Telegram Mini App URL used by the bot.
FRONTEND_URL=https://desktop-nbosdr0.taileecc50.ts.net
ALLOWED_ORIGINS=https://desktop-nbosdr0.taileecc50.ts.net

# The deploy command updates this value for the active release.
APP_VERSION=v0.0.1
NEWS_DB_NAME=news
DEPLOY_ADMIN_TOKEN=replace-with-a-random-admin-token
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-random-grafana-password

# Required by the prod Cloudflare Tunnel container. Create a named tunnel in
# Cloudflare Zero Trust and paste its tunnel token here.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
